# ── AI (Antigravity CLI / agy) ─────────────────────────────────────────────────
# AI_BACKEND=antigravity
# ANTIGRAVITY_MODEL=gemini-3.5-flash-high
# AI_LANGUAGE=pt-BR

# ── Kindle Delivery ────────────────────────────────────────────────────────────
#
# 1. Find your Kindle email at:
#    Amazon → Account & Lists → Manage Your Content and Devices → Preferences → Personal Document Settings
#
# 2. Whitelist SMTP_USER as an approved sender in the same "Approved Personal Document E-mail List" section.
#
# 3. For Gmail, SMTP_PASSWORD must be an App Password (not your regular password).
#    Generate one at: https://myaccount.google.com/apppasswords

KINDLE_EMAIL=your-name@kindle.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: require Bearer token for dashboard write APIs (POST/PUT/DELETE)
# DASHBOARD_TOKEN=generate-a-long-random-string

# Jev (TypeSafe) news triage — ads, keep/drop, relevance, temas.
# TYPESAFE_API_KEY stays in this file, not in the dashboard database.
# TYPESAFE_API_KEY=
# JEV_TRIAGE_ENABLED=false
# JEV_WORKERS=4
# JEV_MIN_KEEP=0

# Linear auth for scripts/linear-review-inbox.py
# Personal API keys (lin_api_…) are not available on the free plan.
# Use the OAuth app instead:
#   Linear → Settings → Administration → API → your app
#   Enable "Client credentials tokens"
#   Paste the client id and secret here.
# https://linear.app/developers/oauth-2-0-authentication
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# Optional if you already have a token:
# LINEAR_ACCESS_TOKEN=
# LINEAR_API_KEY=lin_api_...
